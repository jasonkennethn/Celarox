{
  "expo": {
    "name": "Celarox Enterprise",
    "slug": "celarox-enterprise",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0A0D14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.celarox.enterprise"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0D14",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.celarox.enterprise"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    }
  }
}
